{
  "name": "enginebox",
  "version": "1.0.0",
  "description": "EngineBox — Engine OS to Rekordbox playlist converter",
  "main": "electron/main.js",
  "scripts": {
    "convert": "python3 convert.py",
    "test": "python3 -m unittest discover -s tests",
    "test:all": "npm run test && npm run test:e2e",
    "server": "python3 server.py",
    "ui:dev": "npx vite",
    "ui:build": "npx vite build",
    "dev": "concurrently \"npm run server\" \"npm run ui:dev\"",
    "test:e2e": "npx playwright test",
    "test:e2e:ui": "npx playwright test --ui",
    "icons:generate": "bash scripts/generate-icon.sh",
    "electron:dev": "npm run icons:generate && npm run ui:build && electron .",
    "electron:build": "npm run icons:generate && npm run ui:build && electron-builder --mac && mkdir -p releases && cp dist-electron/*.dmg releases/ && xattr -dr com.apple.quarantine releases/*.dmg",
  },
  "private": true,
  "build": {
    "appId": "com.enginebox.app",
    "productName": "EngineBox",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "electron/**/*",
      "server.py",
      "convert.py",
      "converter/**/*",
      "dist/**/*",
      "!**/node_modules/**",
      "!**/__pycache__/**",
      "!**/*.pyc"
    ],
    "asarUnpack": [
      "server.py",
      "convert.py",
      "converter/**/*",
      "dist/**/*"
    ],
    "mac": {
      "target": "dmg",
      "category": "public.app-category.music",
      "icon": "electron/icon.icns"
    }
  },
  "dependencies": {
    "@picocss/pico": "^2.1.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^10.0.3",
    "electron": "^35.7.0",
    "electron-builder": "^26.0.12",
    "oxlint": "^1.71.0",
    "vite": "^8.1.1"
  }
}
