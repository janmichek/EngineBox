{
  "name": "enginebox",
  "version": "1.0.0",
  "description": "EngineBox — Engine OS to Rekordbox playlist converter",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "convert": "node convert.js",
    "test": "vitest run",
    "test:all": "npm run test && npm run test:e2e",
    "server": "node server.js",
    "ui:dev": "npx vite",
    "ui:build": "npx vite build",
    "build": "npm run ui:build",
    "dev": "concurrently \"npm run server\" \"npm run ui:dev\"",
    "test:e2e": "npx playwright test",
    "test:e2e:ui": "npx playwright test --ui",
    "icons:generate": "bash scripts/generate-icon.sh",
    "electron:dev": "npm run icons:generate && npm run ui:build && electron .",
    "electron:build": "npm run icons:generate && npm run ui:build && electron-builder --mac && mkdir -p releases && cp dist-electron/*.dmg releases/ && xattr -dr com.apple.quarantine releases/*.dmg"
  },
  "private": true,
  "build": {
    "appId": "com.enginebox.app",
    "productName": "EngineBox",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "electron/**/*",
      "server.js",
      "convert.js",
      "converter/**/*",
      "dist/**/*",
      "!**/node_modules/**"
    ],
    "asarUnpack": [
      "server.js",
      "convert.js",
      "converter/**/*",
      "dist/**/*"
    ],
    "mac": {
      "target": "dmg",
      "category": "public.app-category.music",
      "icon": "electron/icon.icns"
    }
  },
  "dependencies": {
    "@picocss/pico": "^2.1.1",
    "better-sqlite3": "^13.0.1",
    "buffer": "^6.0.3",
    "fast-xml-parser": "^5.10.1",
    "fflate": "^0.8.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "sql.js": "^1.14.1",
    "xmlbuilder2": "^4.0.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^10.0.3",
    "electron": "^35.7.0",
    "electron-builder": "^26.0.12",
    "oxlint": "^1.71.0",
    "vite": "^8.1.1",
    "vite-plugin-node-polyfills": "^0.28.0",
    "vitest": "^4.1.10"
  }
}
